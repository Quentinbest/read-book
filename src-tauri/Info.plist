<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the bundle's Info.plist by Tauri. CFBundleLocalizations tells macOS
  which languages Linen has: System Settings offers a per-app language only when
  there are several, and AppKit's own text (open and save panels, standard menu
  items it draws) follows the one chosen. List only languages whose catalogue
  ships (docs/spikes/i18n-spike.md, finding 4); src/lib/strings/index.test.ts
  checks that this list matches src/lib/strings/index.ts.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ja</string>
		<string>es</string>
	</array>
</dict>
</plist>
