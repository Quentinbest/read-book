{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linen spikes",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "backgroundThrottling": "disabled",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 25
        }
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "spikes-e2e",
          "windows": ["main"],
          "permissions": ["core:window:allow-set-size", "core:window:allow-inner-size"]
        }
      ]
    }
  }
}
