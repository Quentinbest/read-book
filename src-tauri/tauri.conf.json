{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Linen",
  "version": "0.2.0",
  "identifier": "app.linen.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Linen",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' blob: data: linen-book:",
        "font-src": "'self' blob: data:",
        "media-src": "blob: linen-book:",
        "frame-src": "blob: linen-ext:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/linen-a-v002/32x32.png",
      "icons/linen-a-v002/128x128.png",
      "icons/linen-a-v002/128x128@2x.png",
      "icons/linen-a-v002/icon.icns",
      "icons/linen-a-v002/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "mimeType": "application/epub+zip",
        "name": "EPUB book",
        "role": "Viewer",
        "description": "EPUB book",
        "contentTypes": ["org.idpf.epub-container"]
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0RTY3RjJGRkVGRERBRjAKUldUdzJ2MytMMy9tMU5pTmtRM2pXK3ZhOUhLcE43TFExQVFScDYrOUQ0WGV0bDdvZEVKMVZiNlcK",
      "endpoints": ["https://github.com/Quentinbest/read-book/releases/latest/download/latest.json"]
    }
  }
}
